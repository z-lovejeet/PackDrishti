# ==============================================================================
# PackDrashiti Backend Core Service Environment Configuration Template
# Project ID: SIH26034
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Runtime Settings
# ------------------------------------------------------------------------------
APP_NAME=PackDrashiti
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# 2. Relational Database Configuration (PostgreSQL with pgvector)
# ------------------------------------------------------------------------------
# Standard Connection URI Format:
# postgresql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql://packdrashiti_user:packdrashiti_pass@localhost:5432/packdrashiti_db

# Connection Pool Configurations
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30

# ------------------------------------------------------------------------------
# 3. Redis Cache & Broker Configuration
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 4. Authentication, Tokenization & Security
# ------------------------------------------------------------------------------
# Generate a 256-bit key using: openssl rand -hex 32
JWT_SECRET_KEY=4a2e8c1f9b3d7a6e508192c73e4b5a6f80192837465019283746501928374650
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12

# ------------------------------------------------------------------------------
# 5. Storage Architecture (Packaging Images & Inspection Dockets)
# ------------------------------------------------------------------------------
# Provider options: local | s3 | cloudflare_r2
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./uploads

# S3 or Cloudflare R2 Settings (used when STORAGE_PROVIDER=s3 or cloudflare_r2)
S3_ENDPOINT_URL=
S3_BUCKET_NAME=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto

# ------------------------------------------------------------------------------
# 6. Cross-Origin Resource Sharing (CORS)
# ------------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# 7. Computer Vision & Optical Pipeline Integration
# ------------------------------------------------------------------------------
OCR_ENGINE=paddleocr
OCR_USE_GPU=false
OCR_CONFIDENCE_THRESHOLD=0.60
CALIBRATION_PIXEL_PER_MM=11.81

# ------------------------------------------------------------------------------
# 8. LLM & Statutory RAG Pipeline Configuration
# ------------------------------------------------------------------------------
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
VECTOR_DIMENSION=1536
