# ==============================================================================
# PackDrashiti Backend Core Service Environment Configuration Template
# Project ID: SIH26034
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Runtime Settings
# ------------------------------------------------------------------------------
APP_NAME=PackDrashiti
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# 2. Supabase Unified Relational Database & Vector Store (pgvector)
# ------------------------------------------------------------------------------
# Supabase Project Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Direct Connection URI for SQLAlchemy & Alembic (from Supabase Database Settings):
# postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://packdrashiti_user:packdrashiti_pass@localhost:5432/packdrashiti_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30

# ------------------------------------------------------------------------------
# 3. In-Memory Zero-Manual Cache (No Redis Required)
# ------------------------------------------------------------------------------
CACHE_TTL_SECONDS=3600
CACHE_MAX_ITEMS=5000

# ------------------------------------------------------------------------------
# 4. Authentication, Tokenization & Security (Supabase Auth)
# ------------------------------------------------------------------------------
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------------------------
# 5. Storage Architecture (Packaging Images & Inspection Dockets)
# ------------------------------------------------------------------------------
# Provider options: supabase | local | s3
STORAGE_PROVIDER=supabase
STORAGE_LOCAL_DIR=./uploads
STORAGE_BUCKET_NAME=packaging-scans

# ------------------------------------------------------------------------------
# 6. Cross-Origin Resource Sharing (CORS)
# ------------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# 7. Optical & Spatial Perception Pipeline (Zero Manual Step)
# ------------------------------------------------------------------------------
OCR_ENGINE=multimodal_vlm
OCR_USE_GPU=false
OCR_CONFIDENCE_THRESHOLD=0.60
CALIBRATION_PIXEL_PER_MM=11.81

# ------------------------------------------------------------------------------
# 8. Parallel Dual-LLM & LangGraph Statutory RAG Pipeline Configuration
# ------------------------------------------------------------------------------
# Primary Chain: Gemini Fallback Chain
GEMINI_API_KEY=
GEMINI_FALLBACK_CHAIN=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash-lite

# Secondary Chain: Groq High-Throughput Fallback Chain
GROQ_API_KEY=
GROQ_FALLBACK_CHAIN=gpt-oss-120b,gpt-oss-20b

# Embeddings & Vector Indexing in Supabase pgvector
EMBEDDING_MODEL=text-embedding-3-small
VECTOR_DIMENSION=1536
RAG_FRAMEWORK=langgraph
